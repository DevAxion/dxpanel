# ─────────────────────────────────────────────────────────────
# DXPanel Docker environment
# Copy to .env and fill in before running `docker compose up -d`
# ─────────────────────────────────────────────────────────────

# Public hostname for the panel (used for SSL and links)
PANEL_DOMAIN=panel.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=admin@example.com

# Password for the initial 'admin' login. Leave blank to have one generated and
# printed to the container log on first start (docker compose logs dxpanel).
DXPANEL_ADMIN_PASSWORD=

# Run mode. "true" (default) runs the panel with simulated host commands — right
# for a panel-only container. Set to "false" only on a real host that has
# nginx/bind/postfix/etc. installed.
SIMULATION_MODE=true

# ── MySQL ──────────────────────────────────────────────────────
# Root password for the MySQL service (use a long random value)
MYSQL_ROOT_PASSWORD=change-me-root-password
# Application database + user
MYSQL_DATABASE=dxpanel
MYSQL_USER=dxpanel
MYSQL_PASSWORD=change-me-app-password

# ── Stripe (leave blank to run billing in simulation mode) ────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
