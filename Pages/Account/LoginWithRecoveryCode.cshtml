@page
@model DXPanel.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code sign in";
    Layout = "_LoginLayout";
}

<div class="dx-login-wrapper">
    <div class="dx-login-card">
        <div class="text-center mb-4">
            <div class="dx-login-brand">Recovery code</div>
            <div class="text-secondary small mt-1">Enter one of your saved recovery codes</div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label">Recovery code</label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="xxxxx-xxxxx" autofocus />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                <div class="form-text text-secondary">Each recovery code can be used only once.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-key"></i> Sign in</button>
        </form>

        <div class="text-center mt-3">
            <a asp-page="/Account/Login" class="accent small">Back to sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
