@page
@model SRXPanel.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_LoginLayout";
}

<div class="srx-login-wrapper">
    <div class="srx-login-card">
        <div class="text-center mb-4">
            <div class="srx-login-brand">Reset your password</div>
            <div class="text-secondary small mt-1">We'll email you a secure reset link</div>
        </div>

        @if (Model.Sent)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle"></i>
                If an account exists for that email address, we've sent a link to reset your password.
                Please check your inbox (and spam folder).
            </div>
            <div class="text-center">
                <a asp-page="/Account/Login" class="btn btn-outline-light w-100"><i class="bi bi-arrow-left"></i> Back to sign in</a>
            </div>
        }
        else
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-envelope"></i> Send reset link
                </button>
            </form>

            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="accent small">Back to sign in</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
