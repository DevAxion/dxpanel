@page
@model SRXPanel.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_LoginLayout";
}

<div class="srx-login-wrapper">
    <div class="srx-login-card">
        <div class="text-center mb-4">
            <div class="srx-login-brand">Choose a new password</div>
        </div>

        @if (Model.Done)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle"></i>
                Your password has been reset. You can now sign in with your new password.
            </div>
            <a asp-page="/Account/Login" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Sign in</a>
        }
        else
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <form method="post">
                <input type="hidden" asp-for="Input.Code" />
                <input type="hidden" asp-for="Input.Email" />

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">New password</label>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    <div class="form-text text-secondary">At least 8 characters, with upper/lowercase, a number and a symbol.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-shield-lock"></i> Reset password</button>
            </form>

            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="accent small">Back to sign in</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
